  "modes": ["external"],
  "packages": {},
  "trial_days": 7,
  "purchase_days": 0,
  "env_prefix": "JAVA_EXAMPLE",
  "external_url": "http://127.0.0.1:3013",
  "secret_env": "JAVA_EXAMPLE_HOST_SECRET",
  "rollback_compatible": true
}
