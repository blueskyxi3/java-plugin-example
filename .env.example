# Generate a secret with: openssl rand -hex 32
# Enter the SAME value when installing in AI Hub, or configure it in the host catalog/environment.
JAVA_EXAMPLE_HOST_SECRET=
JAVA_EXAMPLE_PUBLISHED_PORT=3013
# Optional startup override; leave empty to restore data/runtime.json after restart.
# For a host running on macOS/Windows outside Docker: http://host.docker.internal:3000
# For containers on a shared network: http://ai-hub:3000
JAVA_EXAMPLE_HOST_BASE_URL=

# Optional frontend / Java development settings (see web/README.md).
# JAVA_EXAMPLE_DEV_PORT=5173
# JAVA_EXAMPLE_DEV_USER_ID=123
# JAVA_EXAMPLE_DEV_BACKEND_PORT=3014
# JAVA_EXAMPLE_DEV_BACKEND_URL=http://127.0.0.1:3014
# JAVA_EXAMPLE_DEV_DEBUG_PORT=5005
